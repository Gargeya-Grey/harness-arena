{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-testing.local/schemas/artifact.schema.json",
  "title": "Artifact",
  "description": "One artifact attached to a raw result row.",
  "type": "object",
  "required": ["artifact_id", "role", "mime", "path", "sha256", "derived"],
  "additionalProperties": false,
  "properties": {
    "artifact_id": { "type": "string" },
    "role": {
      "type": "string",
      "enum": ["raw", "render", "thumbnail", "capture", "reference"]
    },
    "mime": { "type": "string" },
    "path": { "type": ["string", "null"] },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "derived": { "type": "boolean" },
    "width": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "height": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "duration_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
