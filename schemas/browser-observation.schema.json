{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-testing.local/schemas/browser-observation.schema.json",
  "title": "Derived browser observation v2",
  "description": "A retained browser report, separate from native scores. Null passed values are unjudged and require the blocked/incomplete cross-field rules enforced by browserObservationProblems.",
  "type": "object",
  "required": ["kind", "version", "created_at", "limits", "checker_sha256", "suite_checkers", "runs", "observations", "cleanup"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "visual-web-browser-observation" },
    "version": { "const": "2" },
    "created_at": { "type": "string", "format": "date-time" },
    "limits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "checker_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "suite_checkers": {
      "type": "object",
      "additionalProperties": { "type": "object", "required": ["sha256"], "properties": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }
    },
    "runs": { "type": "array", "items": { "type": "object" } },
    "browser": { "type": "object" },
    "cleanup": { "type": "object" },
    "validation_problems": { "type": "array", "items": { "type": "string" } },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "case_id", "model_key", "repeat", "latency_ms", "error", "checks", "screenshots"],
        "additionalProperties": false,
        "properties": {
          "run_id": { "type": "string" },
          "case_id": { "type": "string" },
          "model_key": { "type": "string" },
          "repeat": { "type": "integer", "minimum": 0 },
          "latency_ms": { "type": ["number", "null"], "minimum": 0 },
          "error": { "type": ["object", "null"] },
          "scene_load_error": { "type": "string" },
          "workspace_sha256": { "type": "string" },
          "manifest_sha256": { "type": "string" },
          "console_errors": { "type": "array", "items": { "type": "string" } },
          "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
          "screenshots": { "type": "array", "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "state": { "type": "string" }, "viewport": { "type": "object" } }, "additionalProperties": false } }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["name", "passed"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "passed": { "type": ["boolean", "null"] },
        "observed": {},
        "error": { "type": "string" },
        "status": { "type": "string", "enum": ["blocked", "incomplete"] },
        "blocked_by": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reason": { "type": "string" }
      }
    }
  }
}
