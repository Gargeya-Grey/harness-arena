{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-testing.local/schemas/result.schema.json",
  "title": "RawResult",
  "description": "One model response for one case in one repeat. One JSON object per line in raw.jsonl.",
  "type": "object",
  "required": [
    "run_id",
    "case_id",
    "model_key",
    "repeat",
    "started_at",
    "latency_ms",
    "tokens_per_second",
    "tool_calls",
    "skills_used",
    "request",
    "response",
    "usage",
    "cost_usd",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "case_id": { "type": "string" },
    "model_key": { "type": "string" },
    "repeat": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "tokens_per_second": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "skills_used": {
      "type": "array",
      "items": { "type": "string" }
    },
    "request": {
      "type": "object",
      "required": ["prompt_id", "prompt_version", "messages"],
      "additionalProperties": false,
      "properties": {
        "prompt_id": { "type": "string" },
        "prompt_version": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant"]
              },
              "content": { "type": "string" }
            }
          }
        },
        "system_prompt": {
          "type": ["string", "null"],
          "description": "Full system prompt when the harness exposes it; null when injected internally."
        },
        "params": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": ["string", "null"] },
        "finish_reason": { "type": ["string", "null"] }
      }
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "description": "Every prompt token, cached ones included. cache_read_tokens and cache_write_tokens are parts of this count.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "description": "Generated tokens, thinking tokens included when the harness reports them.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "cost_usd": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "error": {
      "type": ["object", "null"],
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Harness-specific extras that do not fit the normalized fields."
    },
    "artifacts": {
      "type": "array",
      "description": "Files or inline outputs attached to this observation.",
      "items": { "$ref": "artifact.schema.json" }
    }
  }
}
